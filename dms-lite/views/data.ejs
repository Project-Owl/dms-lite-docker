<!doctype html><html lang="en"><head><%- include('partials/head') %><link rel="stylesheet" href="/stylesheets/leaflet/leaflet.css"><script src="/stylesheets/leaflet/leaflet.js" defer></script><script src="/scripts/chart.js" defer></script><script src="/gps.js" defer></script><script src="/new-js/visuals.js" type="module"></script><script src="/new-js/table.js" defer></script></head><body><%- include('partials/nav') %><main id="main" class="main-content" tabindex="-1">
<%- include('partials/page-header',{heading:'Messages',refreshPath:'/data'}) %>
<div class="panel-stack"><%- include('partials/messages',{messages:something,overview:false,detailedView:cookies.detailedView==='true',unavailable:false}) %><%- include('partials/chart') %>
<div class="settings-grid"><section class="panel" aria-label="Selected device"><div class="panel-heading"><div><h2>Device reading</h2><p><a class="text-accent" href="/settings">Change device</a></p></div></div><p id="info-status" class="chart-status" role="status">Loading reading…</p><div class="table-scroll" tabindex="0" role="region" aria-label="Monitored reading"><table><thead><tr><th scope="col">Duck ID</th><th scope="col">Topic</th><th scope="col">Payload</th><th scope="col">Time (UTC)</th></tr></thead><tbody id="info-body"></tbody></table></div></section>
<section class="panel" aria-label="Recent alerts"><div class="panel-heading"><div><h2>Browser alerts</h2></div><a class="text-link" href="/settings">Alert settings</a></div><p id="alert-status" class="chart-status" role="status">Checking thresholds…</p><div class="table-scroll" tabindex="0" role="region" aria-label="Alert readings"><table><thead><tr><th scope="col">Duck ID</th><th scope="col">Topic</th><th scope="col">Value</th><th scope="col">Time (UTC)</th></tr></thead><tbody id="alert-body"></tbody></table></div></section></div></div>
</main><%- include('partials/footer') %></body></html>

<!doctype html><html lang="en"><head><%- include('partials/head') %><script src="/new-js/information.js" type="module"></script></head><body><%- include('partials/nav') %><main id="main" class="main-content" tabindex="-1"><%- include('partials/page-header',{heading:'Settings',description:'Display and alert settings are saved in this browser. Configure ingestion on the host.'}) %><p id="settings-options-status" class="status-message" role="status">Loading topics and Ducks…</p><p id="settings-status" class="status-message" role="status"></p>
<div class="settings-grid"><section class="panel"><div class="panel-heading"><div><h2>Display settings</h2></div></div><div class="panel-body"><div class="form-grid"><div class="field"><label for="graphtype">Chart type</label><select id="graphtype"><option value="line">Line</option><option value="bar">Bar</option><option value="multiLine">Two topics</option></select></div><div class="field"><label for="firsttopic">First topic</label><select class="selecttopic" id="firsttopic"></select></div><div class="field"><label for="secondtopic">Second topic</label><select class="selecttopic" id="secondtopic"></select><p>For two-topic charts.</p></div><div class="field"><label for="datamount">Maximum numeric samples</label><input type="number" id="datamount" min="1" max="1000" step="1"><p>1–1,000 numeric readings.</p></div><div class="field"><label for="selectduck">Duck to monitor</label><select class="selectduck" id="selectduck"></select></div></div><div class="field"><label class="flex items-center gap-2" for="detailedView"><input type="checkbox" id="detailedView" <%= cookies.detailedView==='true'?'checked':'' %>>Detailed message view</label><p>Show message ID, path, hops, and device type.</p></div><button type="button" id="toData" class="button primary">Save display settings</button></div></section>
<section class="panel"><div class="panel-heading"><div><h2>Browser alerts</h2></div></div><div class="panel-body"><div class="field"><label for="topic_alert">Topic</label><select class="selecttopic" id="topic_alert"></select></div><div class="form-grid"><div class="field"><label for="min_alert">Minimum</label><input type="number" step="any" id="min_alert"></div><div class="field"><label for="max_alert">Maximum</label><input type="number" step="any" id="max_alert"></div></div><button type="button" id="alert_bt" class="button primary">Save alert threshold</button><div class="notice">Checks up to 1,000 recent messages per topic when you open Messages. No background notifications.</div><div class="mt-6"><h3>Saved thresholds</h3><ul id="saved-alerts" class="mt-3 space-y-3 text-sm text-muted"></ul></div></div></section></div>
<section class="panel mt-6" aria-label="Saved display settings"><div class="panel-heading"><h2>Saved display settings</h2></div><div class="table-scroll" tabindex="0" role="region" aria-label="Saved preferences table"><table id="infoTable"><thead><tr><th scope="col">Duck</th><th scope="col">Chart</th><th scope="col">Topic</th><th scope="col">Second topic</th><th scope="col">Limit</th></tr></thead><tbody id="table_body"></tbody></table></div></section>
</main><%- include('partials/footer') %></body></html>

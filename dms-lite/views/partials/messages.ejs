<section class="panel" aria-label="Latest messages"><div class="panel-heading"><div><h2>Latest messages</h2><p>Raw payloads from your devices</p></div><% if (overview) { %><a class="text-link" href="/data">View all <%- include('icon',{name:'arrow'}) %></a><% } %></div>
<% if (unavailable) { %><div class="panel-body"><p>Latest messages are unavailable.</p><a class="text-link mt-3" href="/">Retry snapshot</a></div><% } else { %>
<% if (!overview && messages.length) { %><div class="filter-bar"><label><span class="sr-only">Search messages</span><input id="message-search" type="search" placeholder="Search device, topic or payload…"></label><label><span class="sr-only">Filter by topic</span><select id="message-topic"><option value="">All topics</option></select></label></div><% } %>
<% if (!messages.length) { %><p class="message-empty">No messages yet. Connect a device using MQTT or serial. <a href="/setup" class="text-accent">Open setup guide</a></p><% } else { %>
<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable message table"><table class="message-table"><caption class="sr-only">Latest received messages, most recent first. Times are UTC.</caption><thead><tr><th scope="col">Time (UTC)</th><th scope="col">Duck ID</th><th scope="col">Topic</th><th scope="col">Payload</th><% if (!overview && detailedView) { %><th scope="col">Message ID</th><th scope="col">Path</th><th scope="col">Hops</th><th scope="col">Type</th><% } %></tr></thead><tbody>
<% for (const duck of messages) { %><tr class="message-row" data-topic="<%= duck.topic %>"><td class="mono text-muted"><time datetime="<%= duck.timestamp %>"><%= formatUtc(duck.timestamp) %></time></td><td class="mono"><%= duck.duck_id %></td><td><span class="topic-tag"><%= duck.topic %></span></td><td><span class="mono"><%= duck.payload %></span>
<% if (!overview && (duck.topic==='gps' || duck.topic==='portal')) { const fields=String(duck.payload).split('*').pop().split(',');const lat=fields[2]?.trim(),lon=fields[3]?.trim();if(lat&&lon&&Number.isFinite(Number(lat))&&Number.isFinite(Number(lon))&&Math.abs(Number(lat))<=90&&Math.abs(Number(lon))<=180) { %>
<div class="gps-link" data-lat="<%= lat %>" data-lon="<%= lon %>"><button type="button" class="gmaps-button" aria-expanded="false">View Google Maps</button><button type="button" class="osm-button" aria-expanded="false">View OpenStreetMap</button></div>
<% }} %></td><% if (!overview && detailedView) { %><td class="mono"><%= duck.message_id %></td><td class="mono"><%= duck.path %></td><td><%= duck.hops %></td><td><%= duck.duck_type %></td><% } %></tr><% } %>
</tbody></table></div><% } %><div class="table-footer"><p id="message-filter-status" role="status">Showing <%= messages.length %><% if(overview){ %> of <%= loadedCount %><% } %> loaded messages</p><p>Snapshot · Refresh to update</p></div><% } %></section>

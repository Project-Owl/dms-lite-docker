<!doctype html><html lang="en"><head><%- include('partials/head') %></head><body><%- include('partials/nav') %><main id="main" class="main-content" tabindex="-1"><%- include('partials/page-header',{eyebrow:'Your network',heading:'Meet your Ducks.',description:'Each device, its latest reading, and when it was last seen.',refreshPath:'/ducks'}) %>
<% if(queued){ %><p class="status-strip" role="status">Command queued for serial dispatch.</p><% } %>
<% if(!something.length){ %><%- include('partials/empty') %><% }else{ %><p class="mb-6 text-sm text-muted">Freshness is based on recent messages, not a live radio connection. Recent means within <%= staleAfterSeconds %> seconds.</p>
<% if(commandsEnabled){ %><p class="notice mb-6">Queueing a command does not confirm delivery to the device.</p><% } %>
<div class="duck-grid"><% for(const duck of something){const status=deviceState(duck.timestamp,staleAfterSeconds,viewNow); %>
<article class="panel duck-card"><div class="flex flex-wrap items-center justify-between gap-3"><span class="duck-symbol"><%- include('partials/icon',{name:'ducks'}) %></span><span class="text-xs <%= status.recent?'text-accent':'text-muted' %>"><span class="status-dot <%= status.recent?'':'stale' %>"></span> <%= status.recent?'Seen recently':'Not seen recently' %></span></div><h2><%= duck.duck_id %></h2><p class="mt-2 text-xs text-muted"><%= status.ageText %></p><dl><dt>Topic</dt><dd><span class="topic-tag"><%= duck.topic %></span></dd><dt>Payload</dt><dd class="mono"><%= duck.payload %></dd><dt>Last seen</dt><dd class="mono"><time datetime="<%= duck.timestamp %>"><%= formatUtc(duck.timestamp) %></time></dd></dl>
<details><summary>Message details</summary><dl><dt>Message ID</dt><dd class="mono"><%= duck.message_id %></dd><dt>Path</dt><dd class="mono"><%= duck.path %></dd><dt>Hops</dt><dd><%= duck.hops %></dd><dt>Device type</dt><dd><%= duck.duck_type %></dd></dl></details>
<% if(commandsEnabled){ %><div class="command-actions"><form action="/ducks/postEnableWiFi" method="post"><input type="hidden" name="duck_id" value="<%= duck.duck_id %>"><button class="button" type="submit">WiFi ON</button></form><form action="/ducks/postDisableWiFi" method="post"><input type="hidden" name="duck_id" value="<%= duck.duck_id %>"><button class="button" type="submit">WiFi OFF</button></form></div><% } %></article><% } %></div><% } %></main><%- include('partials/footer') %></body></html>

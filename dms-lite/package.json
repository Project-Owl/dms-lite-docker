{
  "name": "dms-lite",
  "version": "1.0.0",
  "description": "Lite version of Project Owl Data Management System",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "node --test test/*.test.js",
    "build:css": "tailwindcss -i styles/app.css -o public/stylesheets/app.css --minify",
    "build:css:watch": "tailwindcss -i styles/app.css -o public/stylesheets/app.css --watch",
    "prestart": "npm run build:css"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "ejs": "3.1.10",
    "express": "5.3.0",
    "leaflet": "1.9.4",
    "mariadb": "3.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}

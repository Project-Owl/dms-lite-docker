#!/usr/bin/env node
require('dotenv').config();
const http = require('node:http');
const mariadb = require('mariadb');
const {loadConfig} = require('../config');
const {createDatabase} = require('../routes/db');
const {createApp} = require('../app');
async function main() {
  const config = loadConfig();
  const pool = mariadb.createPool(config.database);
  const db = createDatabase(pool);
  try {await db.initialize();}
  catch (error) {
    await pool.end();
    throw new Error(error.code === 'SCHEMA_INCOMPATIBLE' ? error.message : 'Database initialization failed; check configuration, readiness and schema');
  }
  const server = http.createServer(createApp({...config,db}));
  server.on('error',() => {console.error('HTTP server failed to listen'); pool.end().finally(() => process.exit(1));});
  server.listen(config.port,() => console.log(`DMS Lite listening on port ${config.port}`));
  let stopping = false;
  const stop = () => {
    if (stopping) return;
    stopping = true;
    const timeout = setTimeout(() => process.exit(1),10000).unref();
    server.close(() => pool.end().finally(() => {clearTimeout(timeout); process.exit(0);}));
    server.closeIdleConnections();
  };
  process.on('SIGINT',stop); process.on('SIGTERM',stop);
}
main().catch(error => {console.error(error.message); process.exitCode = 1;});
